# =============================================================================
# API Usage Analytics & Billing Platform - Environment Configuration Template
# =============================================================================
#
# SETUP INSTRUCTIONS:
#   1. Copy this file to create your environment-specific config:
#      cp .env.example .env
#   2. Replace all CHANGE_ME_* values with secure credentials
#   3. Generate secure passwords using: openssl rand -base64 32
#
# SECURITY WARNINGS:
#   - NEVER commit .env files with real credentials to version control
#   - Use different credentials for each environment (dev/test/prod)
#   - Rotate credentials regularly, especially after team member changes
#   - Store production secrets in a secrets manager (Vault, AWS Secrets, etc.)
#
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & Application Settings
# -----------------------------------------------------------------------------
# Options: development, staging, production
APP_ENV=development

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable debug mode (additional logging, stack traces)
DEBUG=false

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
# Main application database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=api_billing
DB_USER=billing
# SECURITY: Generate a strong password: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_billing_password
# SSL mode: disable (dev), require (prod), verify-full (high-security prod)
DB_SSL_MODE=disable
# Connection pool settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Full connection URL (auto-constructed from above, or set directly)
DB_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=${DB_SSL_MODE}

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty for no authentication (local dev only)
REDIS_PASSWORD=
# Redis database number (0-15)
REDIS_DB=0
# Connection pool size
REDIS_POOL_SIZE=10
# Key prefix for multi-tenant isolation
REDIS_KEY_PREFIX=aub:

# Full connection URL
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# -----------------------------------------------------------------------------
# Keycloak Authentication Configuration
# -----------------------------------------------------------------------------
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8080
KEYCLOAK_URL=http://${KEYCLOAK_HOST}:${KEYCLOAK_PORT}

# Keycloak admin credentials (for initial setup only)
KEYCLOAK_ADMIN=admin
# SECURITY: Generate a strong password: openssl rand -base64 32
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin_password

# Keycloak database (separate from main app)
KEYCLOAK_DB_USER=keycloak
# SECURITY: Generate a strong password: openssl rand -base64 32
KEYCLOAK_DB_PASSWORD=CHANGE_ME_keycloak_db_password

# Application realm and client configuration
KEYCLOAK_REALM=api-billing
KEYCLOAK_CLIENT_ID=api-billing
# SECURITY: Generate from Keycloak admin console
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_keycloak_client_secret

# -----------------------------------------------------------------------------
# MinIO Object Storage Configuration (S3-compatible)
# -----------------------------------------------------------------------------
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=${MINIO_HOST}:${MINIO_PORT}
MINIO_ROOT_USER=minioadmin
# SECURITY: Generate a strong password: openssl rand -base64 32
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password

# Application access credentials (create via MinIO console)
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key
MINIO_BUCKET=invoices
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# Kong Gateway Configuration
# -----------------------------------------------------------------------------
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
KONG_PROXY_SSL_PORT=8443

# Kong database mode: off (DB-less), postgres
KONG_DATABASE=off
KONG_DECLARATIVE_CONFIG=/etc/kong/kong.yml

# Rate limiting defaults
KONG_RATE_LIMIT_MINUTE=60
KONG_RATE_LIMIT_HOUR=1000

# -----------------------------------------------------------------------------
# Backend Service Configuration
# -----------------------------------------------------------------------------
# Service ports (internal)
USAGE_SERVICE_PORT=3001
SUBSCRIPTION_SERVICE_PORT=3002
BILLING_SERVICE_PORT=3003
ANALYTICS_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005

# API versioning
API_VERSION=v1

# Request timeout (in seconds)
API_TIMEOUT=30

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# JWT & Security Configuration
# -----------------------------------------------------------------------------
# SECURITY: Generate using: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_64_chars_long_for_security
# Token expiration times
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# API Key configuration
API_KEY_PREFIX_LIVE=sk_live_
API_KEY_PREFIX_TEST=sk_test_
# Hash salt for API keys (never change in production after keys are created)
API_KEY_HASH_SALT=CHANGE_ME_api_key_salt

# -----------------------------------------------------------------------------
# SMTP Email Configuration (Optional)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME="API Billing Platform"
# Enable TLS: true, false
SMTP_TLS=true

# -----------------------------------------------------------------------------
# Frontend Application Configuration
# -----------------------------------------------------------------------------
# Admin Portal (Provider Dashboard)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000
# Customer Portal (Self-service)
NEXT_PUBLIC_CUSTOMER_URL=http://localhost:3001

# API Gateway URL (for frontend API calls)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/${API_VERSION}

# Keycloak configuration for frontend auth
NEXT_PUBLIC_KEYCLOAK_URL=${KEYCLOAK_URL}
NEXT_PUBLIC_KEYCLOAK_REALM=${KEYCLOAK_REALM}
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=${KEYCLOAK_CLIENT_ID}

# Feature flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_WEBHOOKS=true
NEXT_PUBLIC_ENABLE_MULTI_CURRENCY=false

# -----------------------------------------------------------------------------
# Observability & Monitoring
# -----------------------------------------------------------------------------
# OpenTelemetry configuration
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=api-billing

# Prometheus metrics endpoint
METRICS_ENABLED=true
METRICS_PORT=9090

# Logging
LOG_FORMAT=json
LOG_OUTPUT=stdout

# -----------------------------------------------------------------------------
# Worker & Background Jobs Configuration
# -----------------------------------------------------------------------------
# Usage aggregation interval (cron format)
USAGE_AGGREGATION_CRON=*/5 * * * *
# Billing cycle processing (runs daily at 2 AM)
BILLING_CYCLE_CRON=0 2 * * *
# Payment reminder check (runs daily at 9 AM)
PAYMENT_REMINDER_CRON=0 9 * * *

# Worker concurrency
WORKER_CONCURRENCY=5

# -----------------------------------------------------------------------------
# Billing & Payment Configuration
# -----------------------------------------------------------------------------
# Default currency (ISO 4217)
DEFAULT_CURRENCY=THB
# VAT rate (Thailand: 7%)
VAT_RATE=0.07
# Invoice due days
INVOICE_DUE_DAYS=30

# Payment gateway (stripe, omise, manual)
PAYMENT_GATEWAY=manual
# SECURITY: Set in production secrets manager
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Development & Migrations
# -----------------------------------------------------------------------------
# Default backend service for development
BACKEND_SERVICE=usage-service
# Migrations directory path
MIGRATIONS_DIR=backend/migrations
# Auto-migrate on startup (dev only, never in production)
AUTO_MIGRATE=false
