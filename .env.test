# =============================================================================
# API Usage Analytics & Billing Platform - Test Environment Configuration
# =============================================================================
#
# ISOLATED TEST ENVIRONMENT
# Used for automated testing (unit tests, integration tests, CI/CD)
#
# FEATURES:
#   - Isolated test database (api_billing_test)
#   - Separate Redis namespace (aub:test:)
#   - In-memory or mock configurations where possible
#   - Fast teardown/setup for test isolation
#
# USAGE:
#   1. CI/CD pipelines load this file automatically
#   2. Local test runs: APP_ENV=test make test
#   3. Integration tests require: make infra-up first
#
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & Application Settings
# -----------------------------------------------------------------------------
APP_ENV=test
LOG_LEVEL=warn
DEBUG=false

# Disable non-essential features during testing
OTEL_ENABLED=false
METRICS_ENABLED=false

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration (Test Database)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
# IMPORTANT: Uses separate test database to avoid data conflicts
DB_NAME=api_billing_test
DB_USER=billing
DB_PASSWORD=test_billing_password_2024
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=5
DB_MAX_IDLE_CONNS=2
DB_CONN_MAX_LIFETIME=1m

DB_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=${DB_SSL_MODE}

# -----------------------------------------------------------------------------
# Redis Configuration (Test Namespace)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Use separate Redis DB for test isolation
REDIS_DB=1
REDIS_POOL_SIZE=5
# Test-specific key prefix to avoid conflicts
REDIS_KEY_PREFIX=aub:test:

REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# -----------------------------------------------------------------------------
# Keycloak Authentication Configuration (Test Realm)
# -----------------------------------------------------------------------------
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8080
KEYCLOAK_URL=http://${KEYCLOAK_HOST}:${KEYCLOAK_PORT}

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=test_keycloak_admin_2024

KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=test_keycloak_db_2024

# Use separate test realm for isolation
KEYCLOAK_REALM=api-billing-test
KEYCLOAK_CLIENT_ID=api-billing-test
KEYCLOAK_CLIENT_SECRET=test_client_secret_placeholder

# -----------------------------------------------------------------------------
# MinIO Object Storage Configuration (Test Bucket)
# -----------------------------------------------------------------------------
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=${MINIO_HOST}:${MINIO_PORT}

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=test_minio_password_2024

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=test_minio_password_2024
# Test-specific bucket
MINIO_BUCKET=invoices-test
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# Kong Gateway Configuration (Test Mode)
# -----------------------------------------------------------------------------
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
KONG_PROXY_SSL_PORT=8443
KONG_DATABASE=off
KONG_DECLARATIVE_CONFIG=/etc/kong/kong.yml

# Relaxed rate limits for testing
KONG_RATE_LIMIT_MINUTE=10000
KONG_RATE_LIMIT_HOUR=100000

# -----------------------------------------------------------------------------
# Backend Service Configuration (Test Ports)
# -----------------------------------------------------------------------------
# Use different ports to avoid conflicts with dev environment
USAGE_SERVICE_PORT=4001
SUBSCRIPTION_SERVICE_PORT=4002
BILLING_SERVICE_PORT=4003
ANALYTICS_SERVICE_PORT=4004
NOTIFICATION_SERVICE_PORT=4005

API_VERSION=v1
API_TIMEOUT=10
CORS_ALLOWED_ORIGINS=*

# -----------------------------------------------------------------------------
# JWT & Security Configuration (Test Keys)
# -----------------------------------------------------------------------------
JWT_SECRET=test_jwt_secret_for_automated_testing_only_not_for_any_other_use
JWT_ACCESS_TOKEN_EXPIRY=5m
JWT_REFRESH_TOKEN_EXPIRY=1h

API_KEY_PREFIX_LIVE=sk_live_
API_KEY_PREFIX_TEST=sk_test_
API_KEY_HASH_SALT=test_hash_salt_2024

# -----------------------------------------------------------------------------
# SMTP Email Configuration (Mock/Disabled)
# -----------------------------------------------------------------------------
# Emails are mocked during testing
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=test@localhost
SMTP_FROM_NAME="API Billing (Test)"
SMTP_TLS=false

# -----------------------------------------------------------------------------
# Frontend Application Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000
NEXT_PUBLIC_CUSTOMER_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=api-billing-test
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=api-billing-test

NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_WEBHOOKS=true
NEXT_PUBLIC_ENABLE_MULTI_CURRENCY=true

# -----------------------------------------------------------------------------
# Observability & Monitoring (Disabled for Testing)
# -----------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=api-billing-test

METRICS_ENABLED=false
METRICS_PORT=9091

LOG_FORMAT=json
LOG_OUTPUT=stdout

# -----------------------------------------------------------------------------
# Worker & Background Jobs Configuration (Fast Intervals for Testing)
# -----------------------------------------------------------------------------
USAGE_AGGREGATION_CRON=*/1 * * * *
BILLING_CYCLE_CRON=*/5 * * * *
PAYMENT_REMINDER_CRON=*/5 * * * *
WORKER_CONCURRENCY=1

# -----------------------------------------------------------------------------
# Billing & Payment Configuration (Test Mode)
# -----------------------------------------------------------------------------
DEFAULT_CURRENCY=THB
VAT_RATE=0.07
INVOICE_DUE_DAYS=30

PAYMENT_GATEWAY=mock
PAYMENT_GATEWAY_API_KEY=test_payment_key
PAYMENT_GATEWAY_WEBHOOK_SECRET=test_webhook_secret

# -----------------------------------------------------------------------------
# Test-Specific Settings
# -----------------------------------------------------------------------------
BACKEND_SERVICE=usage-service
MIGRATIONS_DIR=backend/migrations
# Auto-migrate for test setup
AUTO_MIGRATE=true

# Test database cleanup settings
TEST_DB_CLEANUP=true
TEST_PARALLEL=true
TEST_TIMEOUT=30s
