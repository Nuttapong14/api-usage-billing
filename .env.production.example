# =============================================================================
# API Usage Analytics & Billing Platform - Production Environment Template
# =============================================================================
#
# PRODUCTION CONFIGURATION TEMPLATE
# This file provides the structure for production deployments.
#
# CRITICAL SECURITY REQUIREMENTS:
#   1. NEVER commit actual production credentials to version control
#   2. Use a secrets manager (HashiCorp Vault, AWS Secrets Manager, etc.)
#   3. All passwords must be cryptographically random (32+ characters)
#   4. Enable SSL/TLS for all service connections
#   5. Implement network segmentation and firewall rules
#   6. Enable audit logging for all sensitive operations
#   7. Set up monitoring and alerting for security events
#
# DEPLOYMENT CHECKLIST:
#   [ ] Generate all passwords using: openssl rand -base64 32
#   [ ] Configure SSL certificates for all services
#   [ ] Set up database replication and backups
#   [ ] Configure Redis with authentication and TLS
#   [ ] Set up Keycloak with production realm and clients
#   [ ] Configure MinIO with proper access policies
#   [ ] Set up monitoring and alerting
#   [ ] Configure log aggregation (ELK, Loki, etc.)
#   [ ] Test disaster recovery procedures
#   [ ] Document runbooks for incident response
#
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & Application Settings
# -----------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=info
DEBUG=false

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
# Production database should be:
#   - On a dedicated managed service (AWS RDS, GCP Cloud SQL, etc.)
#   - With automated backups enabled
#   - In a private subnet with no public access
#   - With connection encryption (SSL) enforced
DB_HOST=your-production-db-host.rds.amazonaws.com
DB_PORT=5432
DB_NAME=api_billing
DB_USER=billing_prod
# SECURITY: Store in secrets manager, inject at runtime
DB_PASSWORD=__INJECT_FROM_SECRETS_MANAGER__
# REQUIRED: Enable SSL for production
DB_SSL_MODE=require
# Tune based on expected load
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

DB_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=${DB_SSL_MODE}

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Production Redis should be:
#   - On a managed service (AWS ElastiCache, Redis Cloud, etc.)
#   - With authentication enabled
#   - In a private subnet with no public access
#   - With encryption in transit (TLS)
REDIS_HOST=your-production-redis.cache.amazonaws.com
REDIS_PORT=6379
# SECURITY: Store in secrets manager
REDIS_PASSWORD=__INJECT_FROM_SECRETS_MANAGER__
REDIS_DB=0
REDIS_POOL_SIZE=25
REDIS_KEY_PREFIX=aub:prod:
# Enable TLS for Redis connections
REDIS_TLS=true

REDIS_URL=rediss://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# -----------------------------------------------------------------------------
# Keycloak Authentication Configuration
# -----------------------------------------------------------------------------
# Production Keycloak should be:
#   - Deployed on dedicated infrastructure or managed service
#   - Behind a load balancer with SSL termination
#   - With its own PostgreSQL database
#   - Configured with production realm and strict security settings
KEYCLOAK_URL=https://auth.your-domain.com
# Admin credentials - only needed for initial setup, disable afterward
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=

# Keycloak database (on separate managed instance)
KEYCLOAK_DB_USER=keycloak_prod
KEYCLOAK_DB_PASSWORD=__INJECT_FROM_SECRETS_MANAGER__

# Production realm configuration
KEYCLOAK_REALM=api-billing
KEYCLOAK_CLIENT_ID=api-billing-prod
# SECURITY: Store in secrets manager
KEYCLOAK_CLIENT_SECRET=__INJECT_FROM_SECRETS_MANAGER__

# -----------------------------------------------------------------------------
# MinIO / S3 Object Storage Configuration
# -----------------------------------------------------------------------------
# Production storage should be:
#   - AWS S3 or MinIO cluster with replication
#   - With IAM roles for access (prefer over access keys)
#   - With bucket policies restricting access
#   - With versioning and lifecycle policies enabled
MINIO_ENDPOINT=s3.your-region.amazonaws.com
# Leave empty when using IAM roles
MINIO_ACCESS_KEY=__INJECT_FROM_SECRETS_MANAGER__
MINIO_SECRET_KEY=__INJECT_FROM_SECRETS_MANAGER__
MINIO_BUCKET=api-billing-invoices-prod
MINIO_REGION=ap-southeast-1
MINIO_USE_SSL=true

# -----------------------------------------------------------------------------
# Kong Gateway Configuration
# -----------------------------------------------------------------------------
# Production Kong should be:
#   - Deployed as a cluster with multiple nodes
#   - Behind a load balancer
#   - With proper rate limiting and security plugins
KONG_PROXY_PORT=443
KONG_ADMIN_PORT=8001
KONG_PROXY_SSL_PORT=443
KONG_DATABASE=postgres
KONG_DECLARATIVE_CONFIG=/etc/kong/kong.yml

# Conservative rate limits for production
KONG_RATE_LIMIT_MINUTE=60
KONG_RATE_LIMIT_HOUR=1000

# -----------------------------------------------------------------------------
# Backend Service Configuration
# -----------------------------------------------------------------------------
USAGE_SERVICE_PORT=3001
SUBSCRIPTION_SERVICE_PORT=3002
BILLING_SERVICE_PORT=3003
ANALYTICS_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005

API_VERSION=v1
API_TIMEOUT=30

# SECURITY: Restrict to your actual domains
CORS_ALLOWED_ORIGINS=https://admin.your-domain.com,https://portal.your-domain.com

# -----------------------------------------------------------------------------
# JWT & Security Configuration
# -----------------------------------------------------------------------------
# SECURITY: Generate unique secrets for each environment
# Use: openssl rand -base64 64
JWT_SECRET=__INJECT_FROM_SECRETS_MANAGER__
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=24h

API_KEY_PREFIX_LIVE=sk_live_
API_KEY_PREFIX_TEST=sk_test_
# SECURITY: Unique salt per environment, never change after deployment
API_KEY_HASH_SALT=__INJECT_FROM_SECRETS_MANAGER__

# -----------------------------------------------------------------------------
# SMTP Email Configuration
# -----------------------------------------------------------------------------
# Production email should be:
#   - On a transactional email service (SendGrid, SES, etc.)
#   - With SPF, DKIM, and DMARC configured
#   - With bounce and complaint handling
SMTP_HOST=email-smtp.your-region.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=__INJECT_FROM_SECRETS_MANAGER__
SMTP_PASSWORD=__INJECT_FROM_SECRETS_MANAGER__
SMTP_FROM=billing@your-domain.com
SMTP_FROM_NAME="API Billing Platform"
SMTP_TLS=true

# -----------------------------------------------------------------------------
# Frontend Application Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_URL=https://admin.your-domain.com
NEXT_PUBLIC_CUSTOMER_URL=https://portal.your-domain.com
NEXT_PUBLIC_API_URL=https://api.your-domain.com/api/v1

NEXT_PUBLIC_KEYCLOAK_URL=https://auth.your-domain.com
NEXT_PUBLIC_KEYCLOAK_REALM=api-billing
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=api-billing-prod

NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_WEBHOOKS=true
NEXT_PUBLIC_ENABLE_MULTI_CURRENCY=true

# -----------------------------------------------------------------------------
# Observability & Monitoring
# -----------------------------------------------------------------------------
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.your-domain.com:4317
OTEL_SERVICE_NAME=api-billing-prod

METRICS_ENABLED=true
METRICS_PORT=9090

LOG_FORMAT=json
LOG_OUTPUT=stdout

# -----------------------------------------------------------------------------
# Worker & Background Jobs Configuration
# -----------------------------------------------------------------------------
USAGE_AGGREGATION_CRON=*/5 * * * *
BILLING_CYCLE_CRON=0 2 * * *
PAYMENT_REMINDER_CRON=0 9 * * *
WORKER_CONCURRENCY=10

# -----------------------------------------------------------------------------
# Billing & Payment Configuration
# -----------------------------------------------------------------------------
DEFAULT_CURRENCY=THB
VAT_RATE=0.07
INVOICE_DUE_DAYS=30

# Production payment gateway (stripe, omise)
PAYMENT_GATEWAY=omise
PAYMENT_GATEWAY_API_KEY=__INJECT_FROM_SECRETS_MANAGER__
PAYMENT_GATEWAY_WEBHOOK_SECRET=__INJECT_FROM_SECRETS_MANAGER__

# -----------------------------------------------------------------------------
# Production Safety Settings
# -----------------------------------------------------------------------------
BACKEND_SERVICE=usage-service
MIGRATIONS_DIR=backend/migrations
# CRITICAL: Never auto-migrate in production
AUTO_MIGRATE=false

# -----------------------------------------------------------------------------
# Additional Production Hardening
# -----------------------------------------------------------------------------
# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_SECOND=100

# Request size limits
MAX_REQUEST_SIZE=10MB
MAX_UPLOAD_SIZE=50MB

# Session settings
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# Security headers
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# Audit logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90
