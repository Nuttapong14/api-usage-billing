backend/tmp/
# =============================================================================
# Environment files (credentials) - NEVER commit files with real secrets
# =============================================================================
# Local environment file (contains your actual credentials)
.env

# Environment-specific local overrides
.env.local
.env.*.local

# Production/staging secrets (NEVER commit these)
.env.production
.env.staging

# =============================================================================
# INTENTIONALLY TRACKED environment files (safe defaults, no real secrets):
# =============================================================================
# .env.example           - Template with placeholder values
# .env.development       - Development defaults (safe placeholder passwords)
# .env.test              - Test environment configuration
# .env.production.example - Production structure template
# =============================================================================
bun-debug.log*

