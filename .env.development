# =============================================================================
# API Usage Analytics & Billing Platform - Development Environment
# =============================================================================
#
# SAFE DEFAULT VALUES FOR LOCAL DEVELOPMENT
# This file is tracked in git with placeholder values only.
#
# TO USE:
#   1. Copy to .env: cp .env.development .env
#   2. Optionally customize values in .env (not required for basic local dev)
#
# WARNING: These passwords are NOT secure and should ONLY be used for local
# development. NEVER use these values in staging or production environments.
#
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & Application Settings
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=debug
DEBUG=true

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=api_billing
DB_USER=billing
# WARNING: Development password only - change for any shared environment
DB_PASSWORD=dev_billing_password_2024
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

DB_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=${DB_SSL_MODE}

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_KEY_PREFIX=aub:dev:

REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# -----------------------------------------------------------------------------
# Keycloak Authentication Configuration
# -----------------------------------------------------------------------------
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8080
KEYCLOAK_URL=http://${KEYCLOAK_HOST}:${KEYCLOAK_PORT}

# WARNING: Development credentials only
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev_keycloak_admin_2024

KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=dev_keycloak_db_2024

KEYCLOAK_REALM=api-billing
KEYCLOAK_CLIENT_ID=api-billing
# NOTE: Generate this from Keycloak admin console after initial setup
KEYCLOAK_CLIENT_SECRET=dev_client_secret_placeholder

# -----------------------------------------------------------------------------
# MinIO Object Storage Configuration
# -----------------------------------------------------------------------------
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=${MINIO_HOST}:${MINIO_PORT}

# WARNING: Development credentials only
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=dev_minio_password_2024

# For development, use root credentials as access keys
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=dev_minio_password_2024
MINIO_BUCKET=invoices
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# Kong Gateway Configuration
# -----------------------------------------------------------------------------
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
KONG_PROXY_SSL_PORT=8443
KONG_DATABASE=off
KONG_DECLARATIVE_CONFIG=/etc/kong/kong.yml

KONG_RATE_LIMIT_MINUTE=1000
KONG_RATE_LIMIT_HOUR=50000

# -----------------------------------------------------------------------------
# Backend Service Configuration
# -----------------------------------------------------------------------------
USAGE_SERVICE_PORT=3001
SUBSCRIPTION_SERVICE_PORT=3002
BILLING_SERVICE_PORT=3003
ANALYTICS_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005

API_VERSION=v1
API_TIMEOUT=30
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000

# -----------------------------------------------------------------------------
# JWT & Security Configuration
# -----------------------------------------------------------------------------
# WARNING: Development secret only - never use in production
JWT_SECRET=dev_jwt_secret_for_local_development_only_not_for_production_use_2024
JWT_ACCESS_TOKEN_EXPIRY=1h
JWT_REFRESH_TOKEN_EXPIRY=7d

API_KEY_PREFIX_LIVE=sk_live_
API_KEY_PREFIX_TEST=sk_test_
API_KEY_HASH_SALT=dev_hash_salt_2024

# -----------------------------------------------------------------------------
# SMTP Email Configuration (Disabled for development)
# -----------------------------------------------------------------------------
# Use Mailhog or similar for local email testing
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=dev@localhost
SMTP_FROM_NAME="API Billing (Dev)"
SMTP_TLS=false

# -----------------------------------------------------------------------------
# Frontend Application Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000
NEXT_PUBLIC_CUSTOMER_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=api-billing
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=api-billing

NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_WEBHOOKS=true
NEXT_PUBLIC_ENABLE_MULTI_CURRENCY=true

# -----------------------------------------------------------------------------
# Observability & Monitoring
# -----------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=api-billing-dev

METRICS_ENABLED=true
METRICS_PORT=9090

LOG_FORMAT=text
LOG_OUTPUT=stdout

# -----------------------------------------------------------------------------
# Worker & Background Jobs Configuration
# -----------------------------------------------------------------------------
USAGE_AGGREGATION_CRON=*/1 * * * *
BILLING_CYCLE_CRON=0 2 * * *
PAYMENT_REMINDER_CRON=0 9 * * *
WORKER_CONCURRENCY=3

# -----------------------------------------------------------------------------
# Billing & Payment Configuration
# -----------------------------------------------------------------------------
DEFAULT_CURRENCY=THB
VAT_RATE=0.07
INVOICE_DUE_DAYS=30

PAYMENT_GATEWAY=manual
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Development & Migrations
# -----------------------------------------------------------------------------
BACKEND_SERVICE=usage-service
MIGRATIONS_DIR=backend/migrations
AUTO_MIGRATE=true
