{
  "name": "api-usage-billing-frontend",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf node_modules apps/*/.next apps/*/node_modules packages/*/node_modules .turbo",
    "preinstall": "echo 'Using bun for package management'"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "eslint": "^9.0.0",
    "prettier": "^3.2.5",
    "turbo": "^2.3.3",
    "typescript": "^5.4.5"
  },
  "trustedDependencies": ["turbo"]
}
