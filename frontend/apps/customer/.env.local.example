# =============================================================================
# Customer Portal (Self-Service) - Local Environment
# =============================================================================
#
# Copy to .env.local for local development:
#   cp .env.local.example .env.local
#
# These values override the root .env file for the customer app specifically.
# =============================================================================

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Authentication (Keycloak)
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=api-billing
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=api-billing-customer

# App URLs
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000
NEXT_PUBLIC_CUSTOMER_URL=http://localhost:3001

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_WEBHOOKS=true
NEXT_PUBLIC_ENABLE_MULTI_CURRENCY=false

# Customer-specific features
NEXT_PUBLIC_ENABLE_API_KEY_MANAGEMENT=true
NEXT_PUBLIC_ENABLE_USAGE_DASHBOARD=true
NEXT_PUBLIC_ENABLE_BILLING_HISTORY=true
NEXT_PUBLIC_ENABLE_SUBSCRIPTION_UPGRADE=true
NEXT_PUBLIC_ENABLE_WEBHOOK_MANAGEMENT=true
