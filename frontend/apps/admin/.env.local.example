# =============================================================================
# Admin Portal (Provider Dashboard) - Local Environment
# =============================================================================
#
# Copy to .env.local for local development:
#   cp .env.local.example .env.local
#
# These values override the root .env file for the admin app specifically.
# =============================================================================

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Authentication (Keycloak)
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=api-billing
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=api-billing-admin

# App URLs
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000
NEXT_PUBLIC_CUSTOMER_URL=http://localhost:3001

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_WEBHOOKS=true
NEXT_PUBLIC_ENABLE_MULTI_CURRENCY=true
NEXT_PUBLIC_ENABLE_TIER_MANAGEMENT=true
NEXT_PUBLIC_ENABLE_CUSTOMER_IMPORT=true

# Admin-specific features
NEXT_PUBLIC_ENABLE_AUDIT_LOG=true
NEXT_PUBLIC_ENABLE_REVENUE_REPORTS=true
NEXT_PUBLIC_ENABLE_USAGE_ALERTS=true
